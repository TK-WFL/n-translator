# 「Deploy to Cloudflare」の画面で入力する値です（このファイルには書き込まないでください）。
# Values you enter on the "Deploy to Cloudflare" screen (do not write them in this file).
# ローカルで動かすときは、このファイルを .dev.vars（Cloudflare 版）または .env（node server.mjs）にコピーして値を書きます。

# Soniox の API キー（https://console.soniox.com で発行）/ Soniox API key
SONIOX_API_KEY=

# 翻訳画面を開くための合言葉。自分で決めます（16文字以上。20文字以上のランダムな文字列がおすすめ）
# A passphrase you choose to open the app (at least 16 characters; 20+ random characters recommended)
ACCESS_KEY=

# Notion の内部接続（インテグレーション）の API トークン（ntn_ で始まる）
# Notion internal connection API token (starts with ntn_)
NOTION_TOKEN=

# 記録先のページは、接続を追加したページが自動で使われます。複数のページに接続を追加した場合だけ、
# Cloudflare の「変数とシークレット」に NOTION_PARENT_PAGE（ページの URL）を追加してください。
# The log page is detected automatically (the page you added the connection to). Only if the connection
# has access to several top-level pages, add NOTION_PARENT_PAGE (the page URL) in Cloudflare's "Variables and Secrets".
# 個人用アクセストークン（PAT）を使うときは NOTION_PARENT_PAGE が必須です。翻訳ログを別の場所に置くときは NOTION_DATABASE（データベースの URL）。
# NOTION_PARENT_PAGE is required with a personal access token (PAT). To keep the log elsewhere, set NOTION_DATABASE (the database URL).
